{
  "id": "/",
  "name": "ENFapp",
  "short_name": "ENFapp",
  "description": "App para técnicos em enfermagem: plantões, alarmes de medicamentos, relatórios, documentos, assinatura e financeiro.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0e0f",
  "theme_color": "#0c0e0f",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["medical", "productivity", "finance"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  },
  "shortcuts": [
    {
      "name": "Plantões",
      "short_name": "Plantões",
      "description": "Ver escala e plantões agendados",
      "url": "/?tab=plantoes",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Medicamentos",
      "short_name": "Alarmes",
      "description": "Abrir alarmes de medicamentos",
      "url": "/?med=1",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Relatórios",
      "short_name": "Relatórios",
      "description": "Evolução e relatórios de enfermagem",
      "url": "/?tab=rel",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Financeiro",
      "short_name": "Financeiro",
      "description": "Entradas, despesas e saldo mensal",
      "url": "/?tab=fin",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
